# Conexión a Postgres. En local, la base de compose.yaml; en producción, el pooler de Supabase.
DATABASE_URL=postgres://caro:caro@localhost:5433/caro
# Base separada para los tests de integración (se borra y recrea en cada corrida).
TEST_DATABASE_URL=postgres://caro:caro@localhost:5433/caro_test
# Avisos push para Caro (opcional en local). Genera las claves con
# `pnpm --filter @caro/api push:keys`; sin las tres variables no se envían avisos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
