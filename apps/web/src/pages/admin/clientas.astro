---
import { AdminClients } from "../../components/AdminClients";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Clientas · Panel de Caro"
  description="Panel de Caro Restrepo Nails para ver las clientas y restablecerles la contraseña."
>
  <main class="mx-auto flex max-w-md flex-col gap-6 px-4 py-10">
    <a href="/" class="text-sm text-neutral-600 underline">← Volver al inicio</a>
    <h1 class="text-2xl font-semibold tracking-tight">Clientas</h1>
    <p class="text-neutral-600">
      Si una clienta olvidó su contraseña, genera una nueva y envíasela por WhatsApp. Al generarla
      se cierran sus sesiones abiertas.
    </p>
    <AdminClients client:load />
  </main>
</BaseLayout>
