---
import { AdminServices } from "../../components/AdminServices";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Servicios · Panel de Caro"
  description="Panel de Caro Restrepo Nails para administrar los servicios del catálogo."
  wide
>
  <main class="mx-auto flex max-w-md flex-col gap-6 px-4 py-10 md:max-w-5xl md:px-8">
    <h1 class="text-3xl">Servicios</h1>
    <p class="text-muted">
      Los servicios inactivos no aparecen en el catálogo. Los cambios de precio o duración no
      afectan las citas ya reservadas.
    </p>
    <AdminServices client:load />
  </main>
</BaseLayout>
