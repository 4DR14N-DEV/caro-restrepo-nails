---
import { AuthStatus } from "../components/AuthStatus";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Caro Restrepo Nails"
  description="Spa de uñas de Caro Restrepo: semipermanente, acrílico, press on y más."
>
  <main class="mx-auto flex max-w-md flex-col gap-6 px-4 py-12 text-center">
    <h1 class="text-3xl font-semibold tracking-tight">Caro Restrepo Nails</h1>
    <p class="text-neutral-600">Muy pronto podrás reservar tu cita en línea.</p>
    <AuthStatus client:load />
  </main>
</BaseLayout>
