---
import { MyAppointments } from "../components/MyAppointments";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Mis citas · Caro Restrepo Nails"
  description="Tus citas próximas y tu historial en Caro Restrepo Nails."
>
  <main class="mx-auto flex max-w-md flex-col gap-6 px-4 py-10">
    <a href="/" class="text-sm text-neutral-600 underline">← Volver al inicio</a>
    <h1 class="text-2xl font-semibold tracking-tight">Mis citas</h1>
    <MyAppointments client:load />
  </main>
</BaseLayout>
