---
import { RegisterForm } from "../components/RegisterForm";
import KeepNext from "../components/KeepNext.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Crear cuenta · Caro Restrepo Nails"
  description="Crea tu cuenta para reservar tus citas en Caro Restrepo Nails."
>
  <main class="mx-auto flex max-w-md flex-col gap-6 px-4 py-10">
    <a href="/" class="text-sm text-neutral-600 underline">← Volver al inicio</a>
    <div class="flex flex-col gap-2">
      <h1 class="text-2xl font-semibold tracking-tight">Crear cuenta</h1>
      <p class="text-neutral-600">Solo te pedimos tu nombre y tu celular.</p>
    </div>
    <RegisterForm client:load />
    <p class="text-center text-sm text-neutral-600">
      ¿Ya tienes cuenta? <a href="/ingreso" data-keep-next class="font-medium underline">Ingresa</a>
    </p>
  </main>
  <KeepNext />
</BaseLayout>
