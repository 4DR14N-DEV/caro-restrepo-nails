---
import { BookingFlow } from "../components/BookingFlow";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Reservar · Caro Restrepo Nails"
  description="Elige tus servicios, el día y la hora, y reserva tu cita con Caro Restrepo Nails."
>
  <main class="mx-auto flex max-w-md flex-col gap-6 px-4 py-10">
    <a href="/" class="text-sm text-neutral-600 underline">← Volver al inicio</a>
    <h1 class="text-2xl font-semibold tracking-tight">Reservar</h1>
    <BookingFlow client:load />
  </main>
</BaseLayout>
