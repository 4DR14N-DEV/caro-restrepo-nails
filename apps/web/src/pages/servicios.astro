---
import { ServiceCatalog } from "../components/ServiceCatalog";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Servicios · Caro Restrepo Nails"
  description="Servicios de Caro Restrepo Nails con precio y duración: semipermanente, acrílico, press on y más."
>
  <!-- Espacio abajo para que el resumen fijo no tape el último servicio. -->
  <main class="mx-auto flex max-w-md flex-col gap-6 px-4 pt-10 pb-28">
    <a href="/" class="text-sm text-neutral-600 underline">← Volver al inicio</a>
    <h1 class="text-2xl font-semibold tracking-tight">Servicios</h1>
    <p class="text-neutral-600">Elige uno o varios para ver cuánto tiempo y cuánto cuesta en total.</p>
    <ServiceCatalog client:load />
  </main>
</BaseLayout>
